# Database Connection URL (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_erp?schema=public"

# Redis Cache & Queue (Redis 7)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Application Security
JWT_SECRET="erp-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=4000
NODE_ENV="development"
